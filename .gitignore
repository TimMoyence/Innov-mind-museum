# Build artifacts
*.aab
*.apk
*.ipa
.gitnexus
# GitNexus cartes de cluster auto-générées + index routable — dérivés du graphe .gitnexus,
# régénérés localement par .claude/hooks/gitnexus-skills-refresh.sh à chaque commit (untracked
# comme .gitnexus lui-même et les snapshots lib-docs). Consommés par /team en local.
.claude/skills/generated/
.claude/skills/cluster-skills-index.json
.claude/skills/gitnexus-area-*/

museum-backend/reports/
new.md

# Xcode SPM user state (keep Package.resolved tracked)
xcshareddata/swiftpm/configuration/

# Claude Code session lock (ephemeral, per-PID)
.claude/scheduled_tasks.lock

# Quality hooks ephemeral cache (bg-runner output + alerts log)
.claude/.cache/

# Agent worktrees (ephemeral isolated workspaces from Agent isolation:"worktree")
.claude/worktrees/

# Perf seed checkpoint (local state, not for VCS)
museum-backend/.perf-seed-checkpoint.json

# C3 (2026-05) — visual-similarity ONNX bundles. Binary, ~340MB; fetched at
# Docker build time by museum-backend/scripts/fetch-models.sh. Never committed.
museum-backend/models/

# Local PGP key material (security@ contact key generation). The PRIVATE key +
# revocation cert MUST NEVER be committed. Root-anchored (leading /) so the
# PUBLIC key that ships — museum-web/public/.well-known/pgp-key.txt — stays
# tracked. See docs/operations/PGP_KEY_GENERATION.md.
/pgp-key.txt
/security-private.asc
/security-revoke.asc
**/*.onnx

# W3 (T5.5) — printable QR-cartel PDFs. Regenerable from fixtures/*.csv via
# scripts/generate-qr-cartels.cjs; binaries, not source.
museum-backend/cartels-*.pdf

# Local pnpm content-addressable store (created by `pnpm install --prefer-offline`
# in some env setups). Never source-tracked.
.pnpm-store/

# Tesseract OCR training data (e.g. museum-backend/eng.traineddata). Multi-MB
# binary models, downloaded/runtime artifacts — never source-tracked.
*.traineddata
