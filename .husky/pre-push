#!/usr/bin/env sh
set -e
lfs_stdin="$(cat)"
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

push_base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo 'HEAD~10')"

( cd museum-backend && pnpm lint )
( cd museum-frontend && npm run lint )
( cd museum-web && pnpm lint )

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --redact --no-banner --config .gitleaks.toml --log-opts="${push_base}..HEAD"
else
  echo "[pre-push] gitleaks absent : brew install gitleaks"
  exit 1
fi

if command -v ast-grep >/dev/null 2>&1; then
  ast-grep scan --config sgconfig.yml --error
fi

( cd museum-backend && pnpm run test:contract:openapi && node scripts/check-migration-down.cjs )

touched_be=$(git diff --name-only --diff-filter=d "$push_base..HEAD" -- 'museum-backend/src/**/*.ts' | grep -vE '\.d\.ts$' || true)
touched_fe=$(git diff --name-only --diff-filter=d "$push_base..HEAD" -- 'museum-frontend/**/*.ts' 'museum-frontend/**/*.tsx' | grep -vE '\.d\.ts$|/__tests__/|/shared/api/generated/' || true)
touched_web=$(git diff --name-only --diff-filter=d "$push_base..HEAD" -- 'museum-web/src/**/*.ts' 'museum-web/src/**/*.tsx' || true)

if [ -n "$touched_be" ]; then
  ( cd museum-backend && pnpm exec jest --watchman=false --runInBand --passWithNoTests --coverage=false --selectProjects unit-integration --findRelatedTests $(echo "$touched_be" | sed 's|^museum-backend/||') )
fi
if [ -n "$touched_fe" ]; then
  ( cd museum-frontend && npx jest --watchman=false --runInBand --forceExit --findRelatedTests --passWithNoTests --coverage=false $(echo "$touched_fe" | sed 's|^museum-frontend/||') )
fi
if [ -n "$touched_web" ]; then
  ( cd museum-web && pnpm exec vitest run --changed "$push_base" --passWithNoTests )
fi

node scripts/sentinels/screen-test-coverage.mjs || exit 1

if command -v git-lfs >/dev/null 2>&1; then
  printf '%s' "$lfs_stdin" | git lfs pre-push "$@"
fi
