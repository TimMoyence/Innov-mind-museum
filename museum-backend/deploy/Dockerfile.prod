FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.3 --activate

COPY --from=ghcr.io/timmoyence/museum-backend-base:siglip-v1 \
     /models/siglip2-base-patch16-224.onnx ./models/siglip2-base-patch16-224.onnx

COPY tools/eslint-plugin-musaium-test-discipline /tools/eslint-plugin-musaium-test-discipline
COPY packages/musaium-shared /packages/musaium-shared

COPY museum-backend/package.json museum-backend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY museum-backend ./
RUN pnpm run build


FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.3 --activate

COPY tools/eslint-plugin-musaium-test-discipline /tools/eslint-plugin-musaium-test-discipline
COPY packages/musaium-shared /packages/musaium-shared

COPY museum-backend/package.json museum-backend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn-v* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY museum-backend/package.json ./

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/openapi ./openapi
COPY --from=build /app/models ./models

RUN find /app/dist -name '*.map' -delete

RUN adduser --system --uid 1001 nodeuser \
    && mkdir -p /app/tmp/uploads \
    && chown -R nodeuser:nogroup /app/tmp
USER nodeuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

STOPSIGNAL SIGTERM

CMD ["node", "dist/src/index.js"]
